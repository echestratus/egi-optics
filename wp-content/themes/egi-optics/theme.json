{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "EGI Optics",
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1400px"
    },
    "background": {
      "backgroundImage": true,
      "backgroundSize": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": true,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "link": true,
      "palette": [
        { "slug": "base", "name": "Base (navy black)", "color": "#040814" },
        { "slug": "surface", "name": "Surface", "color": "#0B132B" },
        { "slug": "surface-2", "name": "Surface 2", "color": "#111B33" },
        { "slug": "border", "name": "Border", "color": "#2D3A56" },
        { "slug": "contrast", "name": "Contrast (text)", "color": "#F1F5F9" },
        { "slug": "muted", "name": "Muted text", "color": "#94A3B8" },
        { "slug": "primary", "name": "Primary blue", "color": "#3B82F6" },
        { "slug": "primary-dark", "name": "Primary dark", "color": "#1D4ED8" },
        { "slug": "accent", "name": "Accent cyan", "color": "#22D3EE" },
        { "slug": "amber", "name": "Amber", "color": "#F59E0B" },
        { "slug": "emerald", "name": "Emerald", "color": "#10B981" },
        { "slug": "violet", "name": "Violet", "color": "#8B5CF6" },
        { "slug": "rose", "name": "Rose", "color": "#EF4444" },
        { "slug": "white", "name": "White", "color": "#FFFFFF" },
        { "slug": "black", "name": "Black", "color": "#000000" }
      ],
      "gradients": [
        { "slug": "hero-glow", "name": "Hero glow", "gradient": "radial-gradient(ellipse at 20% 10%, rgba(59,130,246,0.22) 0%, rgba(4,8,20,0) 55%), radial-gradient(ellipse at 85% 80%, rgba(34,211,238,0.14) 0%, rgba(4,8,20,0) 50%)" },
        { "slug": "surface-fade", "name": "Surface fade", "gradient": "linear-gradient(180deg, #0B132B 0%, #040814 100%)" },
        { "slug": "surface-rise", "name": "Surface rise", "gradient": "linear-gradient(180deg, #040814 0%, #0B132B 100%)" },
        { "slug": "primary-accent", "name": "Primary to accent", "gradient": "linear-gradient(135deg, #3B82F6 0%, #22D3EE 100%)" },
        { "slug": "card", "name": "Card", "gradient": "linear-gradient(160deg, rgba(11,19,43,0.9) 0%, rgba(4,8,20,0.75) 100%)" },
        { "slug": "media-shade", "name": "Media shade", "gradient": "linear-gradient(180deg, rgba(4,8,20,0) 40%, rgba(4,8,20,0.9) 100%)" }
      ]
    },
    "dimensions": {
      "aspectRatio": true,
      "minHeight": true
    },
    "position": {
      "sticky": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        { "slug": "card", "name": "Card", "shadow": "0 1px 0 0 rgba(255,255,255,0.03) inset, 0 10px 40px -20px rgba(0,0,0,0.8)" },
        { "slug": "glow-primary", "name": "Primary glow", "shadow": "0 0 60px -10px rgba(59,130,246,0.35)" },
        { "slug": "glow-accent", "name": "Accent glow", "shadow": "0 0 60px -10px rgba(34,211,238,0.3)" }
      ]
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": [ "px", "em", "rem", "vh", "vw", "%" ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "10", "name": "1", "size": "0.25rem" },
        { "slug": "20", "name": "2", "size": "0.5rem" },
        { "slug": "30", "name": "3", "size": "0.75rem" },
        { "slug": "40", "name": "4", "size": "1rem" },
        { "slug": "50", "name": "5", "size": "1.5rem" },
        { "slug": "60", "name": "6", "size": "clamp(1.5rem, 1rem + 2vw, 2.5rem)" },
        { "slug": "70", "name": "7", "size": "clamp(2rem, 1.25rem + 3vw, 4rem)" },
        { "slug": "80", "name": "8", "size": "clamp(3rem, 2rem + 5vw, 6rem)" },
        { "slug": "90", "name": "9", "size": "clamp(4rem, 2.5rem + 7vw, 8rem)" }
      ]
    },
    "typography": {
      "customFontSize": true,
      "defaultFontSizes": false,
      "dropCap": false,
      "fluid": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textColumns": true,
      "textDecoration": true,
      "textTransform": true,
      "writingMode": false,
      "fontFamilies": [
        {
          "slug": "heading",
          "name": "Space Grotesk",
          "fontFamily": "\"Space Grotesk\", \"DM Sans\", ui-sans-serif, system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "Space Grotesk", "fontStyle": "normal", "fontWeight": "300 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/space-grotesk-latin-wght-normal.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
            { "fontFamily": "Space Grotesk", "fontStyle": "normal", "fontWeight": "300 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/space-grotesk-latin-ext-wght-normal.woff2" ], "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF" }
          ]
        },
        {
          "slug": "body",
          "name": "DM Sans",
          "fontFamily": "\"DM Sans\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
          "fontFace": [
            { "fontFamily": "DM Sans", "fontStyle": "normal", "fontWeight": "100 1000", "fontDisplay": "swap", "src": [ "file:./assets/fonts/dm-sans-latin-wght-normal.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
            { "fontFamily": "DM Sans", "fontStyle": "normal", "fontWeight": "100 1000", "fontDisplay": "swap", "src": [ "file:./assets/fonts/dm-sans-latin-ext-wght-normal.woff2" ], "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF" },
            { "fontFamily": "DM Sans", "fontStyle": "italic", "fontWeight": "100 1000", "fontDisplay": "swap", "src": [ "file:./assets/fonts/dm-sans-latin-wght-italic.woff2" ] }
          ]
        },
        {
          "slug": "mono",
          "name": "JetBrains Mono",
          "fontFamily": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
          "fontFace": [
            { "fontFamily": "JetBrains Mono", "fontStyle": "normal", "fontWeight": "100 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/jetbrains-mono-latin-wght-normal.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
            { "fontFamily": "JetBrains Mono", "fontStyle": "normal", "fontWeight": "100 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/jetbrains-mono-latin-ext-wght-normal.woff2" ], "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF" }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "xs", "name": "Extra small", "size": "0.75rem", "fluid": false },
        { "slug": "sm", "name": "Small", "size": "0.875rem", "fluid": false },
        { "slug": "md", "name": "Medium", "size": "1rem", "fluid": false },
        { "slug": "lg", "name": "Large", "size": "1.125rem", "fluid": { "min": "1.0625rem", "max": "1.25rem" } },
        { "slug": "xl", "name": "Extra large", "size": "1.375rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
        { "slug": "xxl", "name": "XXL", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
        { "slug": "xxxl", "name": "XXXL", "size": "2.25rem", "fluid": { "min": "1.875rem", "max": "2.75rem" } },
        { "slug": "display", "name": "Display", "size": "3rem", "fluid": { "min": "2.25rem", "max": "3.75rem" } },
        { "slug": "hero", "name": "Hero", "size": "4rem", "fluid": { "min": "2.75rem", "max": "5.25rem" } }
      ]
    },
    "custom": {
      "radius": { "sm": "4px", "md": "8px", "lg": "14px", "pill": "999px" },
      "transition": { "fast": "160ms cubic-bezier(.2,.7,.2,1)", "base": "260ms cubic-bezier(.2,.7,.2,1)" },
      "header": { "height": "76px" },
      "line": "1px solid var(--wp--preset--color--border)",
      "tracking": { "label": "0.22em", "tight": "-0.02em" }
    },
    "blocks": {
      "core/button": {
        "border": { "radius": true },
        "shadow": { "defaultPresets": false }
      },
      "core/navigation": {
        "typography": { "fontSizes": [] }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--md)",
      "fontWeight": "400",
      "lineHeight": "1.65"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--50)",
      "padding": {
        "top": "0",
        "right": "var(--wp--preset--spacing--50)",
        "bottom": "0",
        "left": "var(--wp--preset--spacing--50)"
      }
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--accent)" },
        "typography": { "textDecoration": "none" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--white)" },
          "typography": { "textDecoration": "underline" }
        },
        ":focus": {
          "color": { "text": "var(--wp--preset--color--white)" }
        }
      },
      "heading": {
        "color": { "text": "var(--wp--preset--color--white)" },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "600",
          "lineHeight": "1.1",
          "letterSpacing": "var(--wp--custom--tracking--tight)"
        }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--hero)", "lineHeight": "1.02", "fontWeight": "600" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--display)", "lineHeight": "1.08" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--xxxl)", "lineHeight": "1.15" } },
      "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--xxl)", "lineHeight": "1.2" } },
      "h5": { "typography": { "fontSize": "var(--wp--preset--font-size--xl)", "lineHeight": "1.3" } },
      "h6": { "typography": { "fontSize": "var(--wp--preset--font-size--md)", "lineHeight": "1.4", "textTransform": "uppercase", "letterSpacing": "0.12em", "fontWeight": "500" } },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": { "radius": "var(--wp--custom--radius--sm)", "width": "1px", "style": "solid", "color": "transparent" },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontSize": "var(--wp--preset--font-size--sm)",
          "fontWeight": "600",
          "letterSpacing": "0.04em",
          "textTransform": "uppercase",
          "lineHeight": "1"
        },
        "spacing": {
          "padding": { "top": "0.95rem", "right": "1.5rem", "bottom": "0.95rem", "left": "1.5rem" }
        },
        ":hover": {
          "color": { "background": "var(--wp--preset--color--accent)", "text": "var(--wp--preset--color--base)" },
          "border": { "color": "transparent" }
        },
        ":focus": {
          "color": { "background": "var(--wp--preset--color--accent)", "text": "var(--wp--preset--color--base)" },
          "outline": { "color": "var(--wp--preset--color--accent)", "offset": "3px", "style": "solid", "width": "2px" }
        },
        ":active": {
          "color": { "background": "var(--wp--preset--color--primary-dark)", "text": "var(--wp--preset--color--white)" }
        }
      },
      "caption": {
        "color": { "text": "var(--wp--preset--color--muted)" },
        "typography": { "fontSize": "var(--wp--preset--font-size--sm)" }
      },
      "cite": {
        "color": { "text": "var(--wp--preset--color--muted)" },
        "typography": { "fontStyle": "normal" }
      }
    },
    "blocks": {
      "core/paragraph": {
        "color": { "text": "var(--wp--preset--color--muted)" }
      },
      "core/list": {
        "color": { "text": "var(--wp--preset--color--muted)" },
        "spacing": { "padding": { "left": "1.25rem" } }
      },
      "core/site-title": {
        "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "600", "fontSize": "var(--wp--preset--font-size--lg)" },
        "elements": { "link": { "color": { "text": "var(--wp--preset--color--white)" }, ":hover": { "typography": { "textDecoration": "none" }, "color": { "text": "var(--wp--preset--color--accent)" } } } }
      },
      "core/site-tagline": {
        "color": { "text": "var(--wp--preset--color--muted)" },
        "typography": { "fontSize": "var(--wp--preset--font-size--sm)" }
      },
      "core/navigation": {
        "typography": { "fontSize": "var(--wp--preset--font-size--sm)", "fontWeight": "500", "letterSpacing": "0.02em" },
        "color": { "text": "var(--wp--preset--color--contrast)" },
        "elements": {
          "link": {
            "color": { "text": "var(--wp--preset--color--contrast)" },
            ":hover": { "color": { "text": "var(--wp--preset--color--accent)" }, "typography": { "textDecoration": "none" } }
          }
        }
      },
      "core/separator": {
        "color": { "text": "var(--wp--preset--color--border)" },
        "css": "&:not(.is-style-wide):not(.is-style-dots){width:100px}"
      },
      "core/quote": {
        "border": { "left": { "color": "var(--wp--preset--color--primary)", "width": "3px", "style": "solid" } },
        "spacing": { "padding": { "left": "var(--wp--preset--spacing--50)" } },
        "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontSize": "var(--wp--preset--font-size--xl)", "fontStyle": "normal" },
        "color": { "text": "var(--wp--preset--color--white)" }
      },
      "core/pullquote": {
        "border": { "top": { "color": "var(--wp--preset--color--border)", "width": "1px", "style": "solid" }, "bottom": { "color": "var(--wp--preset--color--border)", "width": "1px", "style": "solid" } },
        "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontSize": "var(--wp--preset--font-size--xxl)" }
      },
      "core/table": {
        "typography": { "fontSize": "var(--wp--preset--font-size--sm)" },
        "border": { "color": "var(--wp--preset--color--border)", "width": "1px", "style": "solid" }
      },
      "core/code": {
        "typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "var(--wp--preset--font-size--sm)" },
        "color": { "background": "var(--wp--preset--color--surface)", "text": "var(--wp--preset--color--accent)" },
        "border": { "radius": "var(--wp--custom--radius--md)", "color": "var(--wp--preset--color--border)", "width": "1px", "style": "solid" },
        "spacing": { "padding": { "top": "var(--wp--preset--spacing--40)", "right": "var(--wp--preset--spacing--50)", "bottom": "var(--wp--preset--spacing--40)", "left": "var(--wp--preset--spacing--50)" } }
      },
      "core/post-title": {
        "typography": { "fontSize": "var(--wp--preset--font-size--display)" },
        "elements": { "link": { "color": { "text": "var(--wp--preset--color--white)" }, ":hover": { "color": { "text": "var(--wp--preset--color--accent)" }, "typography": { "textDecoration": "none" } } } }
      },
      "core/post-date": {
        "color": { "text": "var(--wp--preset--color--muted)" },
        "typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "var(--wp--preset--font-size--xs)", "textTransform": "uppercase", "letterSpacing": "0.12em" }
      },
      "core/post-terms": {
        "typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "var(--wp--preset--font-size--xs)", "textTransform": "uppercase", "letterSpacing": "0.12em" },
        "elements": { "link": { "color": { "text": "var(--wp--preset--color--accent)" } } }
      },
      "core/post-excerpt": {
        "color": { "text": "var(--wp--preset--color--muted)" }
      },
      "core/query-pagination": {
        "typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "var(--wp--preset--font-size--sm)", "textTransform": "uppercase", "letterSpacing": "0.1em" },
        "elements": { "link": { "color": { "text": "var(--wp--preset--color--contrast)" }, ":hover": { "color": { "text": "var(--wp--preset--color--accent)" } } } }
      },
      "core/search": {
        "typography": { "fontSize": "var(--wp--preset--font-size--sm)" },
        "css": ".wp-block-search__input{background:var(--wp--preset--color--surface);border:1px solid var(--wp--preset--color--border);color:var(--wp--preset--color--contrast);border-radius:var(--wp--custom--radius--sm);padding:0.75rem 1rem}.wp-block-search__button{background:var(--wp--preset--color--primary);color:#fff;border:0;border-radius:var(--wp--custom--radius--sm);padding:0.75rem 1.25rem;font-weight:600;text-transform:uppercase;letter-spacing:.04em;font-size:var(--wp--preset--font-size--sm)}"
      },
      "core/image": {
        "border": { "radius": "var(--wp--custom--radius--md)" }
      },
      "core/video": {
        "border": { "radius": "var(--wp--custom--radius--md)" }
      },
      "core/gallery": {
        "spacing": { "blockGap": "var(--wp--preset--spacing--30)" }
      },
      "core/file": {
        "color": { "background": "var(--wp--preset--color--surface)" },
        "border": { "color": "var(--wp--preset--color--border)", "width": "1px", "style": "solid", "radius": "var(--wp--custom--radius--md)" },
        "spacing": { "padding": { "top": "var(--wp--preset--spacing--40)", "right": "var(--wp--preset--spacing--50)", "bottom": "var(--wp--preset--spacing--40)", "left": "var(--wp--preset--spacing--50)" } }
      }
    }
  },
  "customTemplates": [
    { "name": "page-landing", "title": "Landing page (no title, full width)", "postTypes": [ "page" ] },
    { "name": "page-narrow", "title": "Narrow page (title + centred content)", "postTypes": [ "page" ] }
  ],
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" },
    { "name": "post-meta", "title": "Post meta", "area": "uncategorized" }
  ],
  "patterns": []
}
